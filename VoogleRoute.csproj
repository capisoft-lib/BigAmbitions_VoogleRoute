<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net6.0</TargetFramework>

    <AssemblyName>VoogleRoute</AssemblyName>

    <RootNamespace>VoogleRoute</RootNamespace>

    <Version>$(ModVersion)</Version>

    <LangVersion>latest</LangVersion>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

  </PropertyGroup>



  <PropertyGroup>

    <BigAmbitionsDir Condition="'$(BIG_AMBITIONS_DIR)' != ''">$(BIG_AMBITIONS_DIR)</BigAmbitionsDir>

    <BigAmbitionsDir Condition="'$(BigAmbitionsDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Big Ambitions</BigAmbitionsDir>

    <MelonDir>$(BigAmbitionsDir)\MelonLoader</MelonDir>

    <Il2CppDir>$(MelonDir)\Il2CppAssemblies</Il2CppDir>

    <ModsDir>$(BigAmbitionsDir)\Mods</ModsDir>

  </PropertyGroup>



  <ItemGroup>

    <EmbeddedResource Include="Resources\steering_wheel.png" />

  </ItemGroup>



  <ItemGroup>

    <Reference Include="MelonLoader">

      <HintPath>$(MelonDir)\net6\MelonLoader.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="0Harmony">

      <HintPath>$(MelonDir)\net6\0Harmony.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="Il2CppInterop.Runtime">

      <HintPath>$(MelonDir)\net6\Il2CppInterop.Runtime.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="Il2CppInterop.Common">

      <HintPath>$(MelonDir)\net6\Il2CppInterop.Common.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="Il2CppBigAmbitions">

      <HintPath>$(Il2CppDir)\Il2CppBigAmbitions.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="Il2CppBigAmbitions.Items">

      <HintPath>$(Il2CppDir)\Il2CppBigAmbitions.Items.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="Il2CppHGExtensions">

      <HintPath>$(Il2CppDir)\Il2CppHGExtensions.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="Il2CppExternalPlugins">

      <HintPath>$(Il2CppDir)\Il2CppExternalPlugins.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="Il2Cppmscorlib">

      <HintPath>$(Il2CppDir)\Il2Cppmscorlib.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="Il2CppSystem">

      <HintPath>$(Il2CppDir)\Il2CppSystem.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="UnityEngine.CoreModule">

      <HintPath>$(Il2CppDir)\UnityEngine.CoreModule.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="UnityEngine.AIModule">

      <HintPath>$(Il2CppDir)\UnityEngine.AIModule.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="UnityEngine.PhysicsModule">

      <HintPath>$(Il2CppDir)\UnityEngine.PhysicsModule.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="UnityEngine.UI">

      <HintPath>$(Il2CppDir)\UnityEngine.UI.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="UnityEngine.UIModule">

      <HintPath>$(Il2CppDir)\UnityEngine.UIModule.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="UnityEngine.ImageConversionModule">

      <HintPath>$(Il2CppDir)\UnityEngine.ImageConversionModule.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="UnityEngine.InputLegacyModule">

      <HintPath>$(Il2CppDir)\UnityEngine.InputLegacyModule.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="UnityEngine.ParticleSystemModule">

      <HintPath>$(Il2CppDir)\UnityEngine.ParticleSystemModule.dll</HintPath>

      <Private>false</Private>

    </Reference>

    <Reference Include="Unity.TextMeshPro">

      <HintPath>$(Il2CppDir)\Unity.TextMeshPro.dll</HintPath>

      <Private>false</Private>

    </Reference>

  </ItemGroup>



  <Target Name="CopyToMods" AfterTargets="Build" Condition="Exists('$(ModsDir)')">

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsDir)" SkipUnchangedFiles="true" />

    <Message Importance="high" Text="VoogleRoute copié vers $(ModsDir)" />

  </Target>

  <Target Name="GenerateModInfo" BeforeTargets="BeforeCompile">

    <PropertyGroup>

      <_ModInfoGenerated>$(IntermediateOutputPath)ModInfo.Generated.cs</_ModInfoGenerated>

    </PropertyGroup>

    <WriteLinesToFile File="$(_ModInfoGenerated)" Overwrite="true" Lines="
namespace VoogleRoute%3B
internal static partial class ModInfo
{
    public const string Version = &quot;$(ModVersion)&quot;%3B
    public const string GameEa = &quot;$(ModGameEa)&quot;%3B
    public const string Author = &quot;$(ModAuthor)&quot;%3B
    public const string GitHubRepository = &quot;$(ModGitHubRepository)&quot;%3B
    public const string GitHubBranch = &quot;$(ModGitHubBranch)&quot;%3B
    public const string NexusUrl = &quot;$(ModNexusUrl)&quot;%3B
    public const string NexusModId = &quot;$(ModNexusModId)&quot;%3B
    public static string LatestManifestUrl =&gt; $&quot;https://raw.githubusercontent.com/{GitHubRepository}/{GitHubBranch}/latest.json&quot;%3B
    public static string LatestReleaseDllUrl =&gt; $&quot;https://github.com/{GitHubRepository}/releases/latest/download/VoogleRoute.dll&quot;%3B
}
" />

    <ItemGroup>

      <Compile Include="$(_ModInfoGenerated)" />

    </ItemGroup>

  </Target>

  <Target Name="WriteLatestManifest" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">

    <PropertyGroup>

      <_LatestJson>$(MSBuildProjectDirectory)\latest.json</_LatestJson>

      <_LatestLines>{
  "name": "Voogle Route",
  "id": "VoogleRoute",
  "version": "$(ModVersion)",
  "gameVersion": "$(ModGameEa)",
  "author": "$(ModAuthor)",
  "dllName": "VoogleRoute.dll",
  "nexusUrl": "$(ModNexusUrl)",
  "nexusModId": $(ModNexusModId),
  "downloadUrl": "https://github.com/$(ModGitHubRepository)/releases/download/v$(ModVersion)/VoogleRoute.dll",
  "latestDownloadUrl": "https://github.com/$(ModGitHubRepository)/releases/latest/download/VoogleRoute.dll",
  "manifestUrl": "https://raw.githubusercontent.com/$(ModGitHubRepository)/$(ModGitHubBranch)/latest.json",
  "changelogUrl": "https://github.com/$(ModGitHubRepository)/blob/$(ModGitHubBranch)/CHANGELOG.md",
  "sha256": null,
  "releaseNotes": "See CHANGELOG.md for v$(ModVersion)."
}</_LatestLines>

    </PropertyGroup>

    <WriteLinesToFile File="$(_LatestJson)" Overwrite="true" Lines="$(_LatestLines)" />

    <Message Importance="high" Text="latest.json updated at $(_LatestJson)" />

  </Target>

  <Target Name="CopyToRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">

    <PropertyGroup>

      <ReleaseDir>$(MSBuildProjectDirectory)\releases\$(ModVersion)</ReleaseDir>

    </PropertyGroup>

    <MakeDir Directories="$(ReleaseDir)" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleaseDir)" SkipUnchangedFiles="false" />

    <Copy SourceFiles="$(MSBuildProjectDirectory)\latest.json" DestinationFolder="$(ReleaseDir)" SkipUnchangedFiles="false" Condition="Exists('$(MSBuildProjectDirectory)\latest.json')" />

    <Message Importance="high" Text="Release assets copied to $(ReleaseDir)" />

  </Target>

</Project>

